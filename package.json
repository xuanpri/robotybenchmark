{
  "name": "multi-robot-stealth-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
