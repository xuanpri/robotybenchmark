    "demo": "node --import tsx scripts/demo.ts"
  },
  "dependencies": {
    "three": "0.178.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/three": "0.178.1",
    "typescript": "5.8.3",
    "tsx": "4.20.5",
    "vite": "6.3.6"
  }
}
